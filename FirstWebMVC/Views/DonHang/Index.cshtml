@model IEnumerable<FirstWebMVC.ViewModels.DonHangViewModel>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách đơn hàng</h2>
    <a class="btn btn-primary" asp-action="Create">Thêm đơn hàng</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã đơn hàng</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Khách hàng</th>
            <th style="width:180px">Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var donHang in Model)
    {
        <tr>
            <td>@donHang.MaDonHang</td>
            <td>@donHang.NgayDat.ToString("yyyy-MM-dd")</td>
            <td>@donHang.TongTien.ToString("C")</td>
            <td>@donHang.TenKhachHang</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Create">Thêm</a>
            </td>
        </tr>
    }
    </tbody>
</table>