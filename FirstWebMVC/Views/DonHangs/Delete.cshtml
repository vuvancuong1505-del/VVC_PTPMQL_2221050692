@model FirstWebMVC.Models.DonHang.DonHang

@{
    ViewData["Title"] = "Xóa đơn hàng";
}

<h1>Xóa đơn hàng</h1>

<h3>Bạn có chắc muốn xóa đơn hàng này không?</h3>

<div>
    <h4>Thông tin đơn hàng</h4>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">
            Ngày đặt
        </dt>
        <dd class="col-sm-10">
            @Model.NgayDat.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            Khách hàng
        </dt>
        <dd class="col-sm-10">
            @Model.KhachHang?.TenKhachHang
        </dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="DonHangId" />

        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>