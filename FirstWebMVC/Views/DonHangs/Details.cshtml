@model FirstWebMVC.Models.DonHang.DonHang

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h1>Chi tiết đơn hàng</h1>

<div>
    <h4>Thông tin đơn hàng</h4>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">
            Ngày đặt
        </dt>
        <dd class="col-sm-10">
            @Model.NgayDat.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            Khách hàng
        </dt>
        <dd class="col-sm-10">
            @Model.KhachHang?.TenKhachHang
        </dd>

        <dt class="col-sm-2">
            Số điện thoại
        </dt>
        <dd class="col-sm-10">
            @Model.KhachHang?.DienThoai
        </dd>

        <dt class="col-sm-2">
            Địa chỉ
        </dt>
        <dd class="col-sm-10">
            @Model.KhachHang?.DiaChi
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.DonHangId" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>