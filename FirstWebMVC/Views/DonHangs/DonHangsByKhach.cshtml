@model IEnumerable<FirstWebMVC.Models.DonHang.DonHang>

@{
    ViewData["Title"] = "Đơn hàng theo khách";
}

<h2>Danh sách đơn hàng</h2>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Ngày đặt</th>
            <th>Khách hàng</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.NgayDat.ToString("dd/MM/yyyy")</td>
            <td>@item.KhachHang?.TenKhachHang</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.DonHangId" class="btn btn-info btn-sm">
                    Xem
                </a>
            </td>
        </tr>
}
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Quay lại</a>