@model FirstWebMVC.Models.DonHang.DonHang

@{
    ViewData["Title"] = "Sửa đơn hàng";
}

<h1>Sửa đơn hàng</h1>

<h4>Thông tin đơn hàng</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="DonHangId" />

            <!-- Ngày đặt -->
            <div class="form-group">
                <label asp-for="NgayDat" class="control-label"></label>
                <input asp-for="NgayDat" class="form-control" type="date" />
                <span asp-validation-for="NgayDat" class="text-danger"></span>
            </div>

            <!-- Khách hàng -->
            <div class="form-group">
                <label asp-for="KhachHangId" class="control-label"></label>
                <select asp-for="KhachHangId" class="form-control" asp-items="ViewBag.KhachHangId">
                    <option value="">-- Chọn khách hàng --</option>
                </select>
                <span asp-validation-for="KhachHangId" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}