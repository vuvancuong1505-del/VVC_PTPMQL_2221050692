@model IEnumerable<FirstWebMVC.Models.DonHang.DonHang>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
}

<h1>Danh sách đơn hàng</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Tạo đơn hàng</a>
</p>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Ngày đặt</th>
            <th>Khách hàng</th>
            <th style="width: 220px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>
                @item.NgayDat.ToString("dd/MM/yyyy")
            </td>

            <td>
                @item.KhachHang?.TenKhachHang
            </td>

            <td>
                <a asp-action="Edit" asp-route-id="@item.DonHangId" class="btn btn-warning btn-sm">Sửa</a>
                <a asp-action="Details" asp-route-id="@item.DonHangId" class="btn btn-info btn-sm">Chi tiết</a>
                <a asp-action="Delete" asp-route-id="@item.DonHangId" class="btn btn-danger btn-sm">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>