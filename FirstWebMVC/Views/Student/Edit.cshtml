@model FirstWebMVC.Models.Student.Student
<h2>Edit Student</h2>
<form asp-action="Edit" method="post">
    <div class="form-group">
        <label for="StudentCode" class="fw-bold">Mã Sinh Viên</label>
        <input type="text" asp-for="StudentCode" class="form-control w-25" readonly/>
    </div>
    <div class="form-group">
        <label for="FullName" class="fw-bold">Họ và tên</label>
        <input type="text" asp-for="FullName" class="form-control w-25"/>
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Submit</button>
</form>