@model FirstWebMVC.Models.Student

@{
    ViewData["Title"] = "Chỉnh sửa sinh viên";
}

<h2>Chỉnh sửa sinh viên</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="StudentCode" />
    <div class="mb-3">
        <label asp-for="StudentCode" class="form-label"></label>
        <input asp-for="StudentCode" class="form-control" readonly />
        <span asp-validation-for="StudentCode" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}