@section Styles{
    <link rel="stylesheet" href="~/css/student.css  "/>
}

@if(ViewBag.Error == true){
    <p class="text-danger">@ViewBag.Message</p>
}
else{
    <p class="text-dark">@ViewBag.Message</p>;
}

<form asp-action="Index" method="post">
    <div class="mb-3">
        <div> 
            Mã sinh viên: 
            <input type="text" class="form-control w-25" name="StudentCode" value="@ViewBag.StudentCode" placeholder="Nhập mã sinh viên của bạn"/> <br />
        </div>
         <div> 
            Họ và tên: 
            <input type="text" class="form-control w-25" name="FullName" value="@ViewBag.FullName" placeholder="Nhập họ tên của bạn" /> <br />
        </div>
        <div>
            <button type="submit" class="btn btn-secondary">Gửi dữ liệu</button> <br />
        </div>
    </div>
</form>






