<h2>Student View index: @ViewBag.ThongBao</h2>
<form asp-action="Index" method="post">
    <input type="text" class="form-control w-25" name="StudentCode"  placeholder="Nhập mã sinh viên của bạn"/> <br />
    <input type="text" class="form-control w-25" name="FullName" placeholder="Nhập họ tên của bạn" /> <br />
    <button type="submit" >Gửi dữ liệu</button> <br />
    
    
</form>




