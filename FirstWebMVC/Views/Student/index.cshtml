@model FirstWebMVC.Models.Student

@{
    ViewData["Title"] = "Student";
}

<h2>Student Form</h2>

<form asp-action="Index" method="post">
    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Họ tên</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StudentCode" class="form-label">Mã sinh viên</label>
        <input asp-for="StudentCode" class="form-control" />
        <span asp-validation-for="StudentCode" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Gửi</button>
</form>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success mt-3">
        @ViewBag.Message
    </div>
}

@if (Model != null && !string.IsNullOrEmpty(Model.StudentCode))
{
    <div class="mt-3">
        <p><strong>Mã sinh viên:</strong> @Model.StudentCode</p>
        <p><strong>Họ tên:</strong> @Model.FullName</p>
    </div>
}
