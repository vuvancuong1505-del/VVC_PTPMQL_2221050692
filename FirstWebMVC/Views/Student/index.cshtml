@model IEnumerable<FirstWebMVC.ViewModels.StudentFacultyViewModel>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách sinh viên</h2>
    <div>
        <a class="btn btn-success me-2" asp-action="Upload">Upload Excel</a>
        <a class="btn btn-info me-2" asp-action="DownloadTemplate">Tải mẫu Excel</a>
        <a class="btn btn-primary" asp-action="Create">Thêm mới</a>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã sinh viên</th>
            <th>Họ và tên</th>
            <th>Email</th>
            <th>Tuổi</th>
            <th>Khoa</th>
            <th style="width:220px">Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var student in Model)
    {
        <tr>
            <td>@student.StudentCode</td>
            <td>@student.FullName</td>
            <td>@student.Email</td>
            <td>@student.Age</td>
            <td>@student.FacultyName</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@student.StudentCode">Sửa</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@student.StudentCode">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>